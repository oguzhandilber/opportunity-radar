# Opportunity Radar Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APP SETTINGS
# =============================================================================
DEBUG=false

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Choose your AI provider: "openrouter", "claude", "gemini", "ollama", or "local"
AI_PROVIDER=openrouter

# OpenRouter (recommended - free powerful models)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-0528
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

# Ollama (local LLM - no API key needed)
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_BASE_URL=http://localhost:11434

# Claude API (Anthropic)
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com

# Gemini API (Google)
# Get your API key from: https://console.cloud.google.com/
GEMINI_API_KEY=

# =============================================================================
# REDDIT API (OPTIONAL - using public JSON API by default)
# =============================================================================
# Only needed if you want higher rate limits
# Get credentials from: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=OpportunityRadar/1.0

# =============================================================================
# SCRAPING SETTINGS
# =============================================================================
SCRAPE_INTERVAL_HOURS=24
MAX_POSTS_PER_SOURCE=100
REQUEST_DELAY_SECONDS=1.0

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated origins for frontend access
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================================
# AUTHENTICATION
# =============================================================================
# API key for protecting endpoints (leave empty to disable - development only!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# =============================================================================
# DATABASE
# =============================================================================
# Options: "sqlite" (default, for development) or "postgresql" (production)
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=opportunity_radar.db

# PostgreSQL Configuration (only needed if DATABASE_TYPE=postgresql)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=opportunity_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DB=opportunity_radar

# =============================================================================
# REDIS (OPTIONAL - for background jobs, not currently in use)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
